%% Shared text buffer - Alice and Bob use same clause names (no Id in send/wait)

%% Shared text buffer
text_buffer([once, upon, a, time, there, lived, in, a, certain, village, a,
	little, country, girl, the, prettiest, creature, who, was, ever, seen,
	her, mother, was, excessively, fond, of, her, and, her, grandmother, doted, on, her, still,
	more, everybody, called, her, little, red, riding, hood, one, day]).

%% Helper to duplicate a list
dup(X, Y?, Z?) :- ground(X?) | Y = X?, Z = X?.

%% === Network switch (2-way) ===
network2((alice, ch([alice, bob, Content|AliceIn], AliceOut?)),
         (bob, ch(BobIn, [alice, bob, Content?|BobOut?]))) :-
    network2((alice, ch(AliceIn?, AliceOut)),
             (bob, ch(BobIn?, BobOut))).

network2((alice, ch(AliceIn, [bob, alice, Content?|AliceOut?])),
         (bob, ch([bob, alice, Content|BobIn], BobOut?))) :-
    network2((alice, ch(AliceIn?, AliceOut)),
             (bob, ch(BobIn?, BobOut))).

%% Termination
network2((alice, ch([], [])), (bob, ch([], []))).

%% === Agent Handler ===
agent_handler(Id, Text, NetIn, NetOut?, Log?) :-
    Id? =?= alice |
    agent_send(Text?, NetIn?, NetOut, Log).

agent_handler(Id, Text, NetIn, NetOut?, Log?) :-
    Id? =?= bob |
    agent_wait(Text?, NetIn?, NetOut, Log).

%% === Agent Send (4 clauses + termination) ===

%% Alice continues: received [bob, alice, _], send next
agent_send([Word, _ | Text], [bob, alice, _|NetIn], [alice, bob, Word?|NetOut?], [Word?|Log?]) :-
    ground(Word?) |
    agent_wait(Text?, NetIn?, NetOut, Log).

%% Bob: received [alice, bob, _], skip 1st, take 2nd
agent_send([_, Word | Text], [alice, bob, _|NetIn], [bob, alice, Word?|NetOut?], [Word?|Log?]) :-
    ground(Word?) |
    agent_wait(Text?, NetIn?, NetOut, Log).

%% Bob: only 1 element left - done
agent_send([_], [alice, bob, _|_], [], []).

%% Alice first send (otherwise = NetIn not yet a message)
agent_send([Word, _ | Text], NetIn, [alice, bob, Word?|NetOut?], [Word?|Log?]) :-
    ground(Word?), otherwise |
    agent_wait(Text?, NetIn?, NetOut, Log).

%% Termination
agent_send([], _, [], []).

%% === Agent Wait (2 clauses + termination) ===

agent_wait(Text, NetIn, NetOut?, Log?) :-
    list(NetIn?), list(Text?) |
    agent_send(Text?, NetIn?, NetOut, Log).

%% Termination
agent_wait([], _, [], []).

%% === Play ===
play_counting(OutAlice?, OutBob?) :-
    text_buffer(Txt),
    dup(Txt?, AliceText, BobText),
    network2((alice, ch(AliceNetOut?, AliceNetIn)),
             (bob, ch(BobNetOut?, BobNetIn))),
    agent_handler(alice, AliceText?, AliceNetIn?, AliceNetOut, OutAlice),
    agent_handler(bob, BobText?, BobNetIn?, BobNetOut, OutBob).

demo :- play_counting(_, _).
