%% Shared text buffer - Alice and Bob use same clause names

%% Shared text buffer
text_buffer([once, upon, a, time, there, lived, in, a, certain, village, a,
 little, country, girl, the, prettiest, creature, who, was, ever, seen,
 her, mother, was, excessively, fond, of, her, and, her, grandmother, doted, on, her, still,
 more, everybody, called, her, little, red, riding, hood, one, day]).

%% Helper to duplicate a list
dup(X, Y?, Z?) :- ground(X?) | Y = X?, Z = X?.

%% === Network switch (2-way) ===
network2((alice, ch([alice, bob, Content|AliceIn], AliceOut?)),
         (bob, ch(BobIn, [alice, bob, Content?|BobOut?]))) :-
    network2((alice, ch(AliceIn?, AliceOut)),
             (bob, ch(BobIn?, BobOut))).

network2((alice, ch(AliceIn, [bob, alice, Content?|AliceOut?])),
         (bob, ch([bob, alice, Content|BobIn], BobOut?))) :-
    network2((alice, ch(AliceIn?, AliceOut)),
             (bob, ch(BobIn?, BobOut))).

%% Termination
network2((alice, ch([], [])), (bob, ch([], []))).

%% === Unified Agent Handler ===
%% Dispatches to agent behavior based on Id
%% Alice starts sending, Bob starts waiting

agent_handler(Id, Text, NetIn, NetOut?, Log?) :-
    Id? =?= alice |
    agent_send(Id?, Text?, NetIn?, NetOut, Log).

agent_handler(Id, Text, NetIn, NetOut?, Log?) :-
    Id? =?= bob |
    agent_wait(Id?, Text?, NetIn?, NetOut, Log).

%% === Agent Send ===
%% Takes 1st element, skips 2nd, sends to partner

%% Alice sends: take 1st word, skip 2nd, send to bob
agent_send(Id, [Word, _ | Text], NetIn, [alice, bob, Word?|NetOut?], [Word?|Log?]) :-
    Id? =?= alice, ground(Word?) |
    agent_wait(Id?, Text?, NetIn?, NetOut, Log).

%% Alice sends: take last word (odd length)
agent_send(Id, [Word], NetIn, [alice, bob, Word?|NetOut?], [Word?|Log?]) :-
    Id? =?= alice, ground(Word?) |
    agent_wait(Id?, [], NetIn?, NetOut, Log).

%% Bob sends: skip 1st, take 2nd, send to alice
agent_send(Id, [_, Word | Text], [alice, bob, _|NetIn], [bob, alice, Word?|NetOut?], [Word?|Log?]) :-
    Id? =?= bob, ground(Word?) |
    agent_wait(Id?, Text?, NetIn?, NetOut, Log).

%% Bob sends: only 1 element left - skip it, done
agent_send(Id, [_], [alice, bob, _|_], NetOut?, Log?) :-
    Id? =?= bob |
    NetOut = [], Log = [].

%% Termination
agent_send(_, [], _, [], []).

%% === Agent Wait ===
%% Waits for message from partner, then continues

%% Alice waits for Bob's response, then sends again
agent_wait(Id, Text, NetIn, NetOut?, Log?) :-
    Id? =?= alice, list(NetIn?), list(Text?) |
    agent_send(Id?, Text?, NetIn?, NetOut, Log).

%% Bob waits for Alice's message, then sends
agent_wait(Id, Text, NetIn, NetOut?, Log?) :-
    Id? =?= bob, list(NetIn?), list(Text?) |
    agent_send(Id?, Text?, NetIn?, NetOut, Log).

%% Termination for wait
agent_wait(_, [], _, [], []).

%% === Play ===
play_counting(OutAlice?, OutBob?) :-
    text_buffer(Txt),
    dup(Txt?, AliceText, BobText),
    network2((alice, ch(AliceNetOut?, AliceNetIn)),
             (bob, ch(BobNetOut?, BobNetIn))),
    agent_handler(alice, AliceText?, AliceNetIn?, AliceNetOut, OutAlice),
    agent_handler(bob, BobText?, BobNetIn?, BobNetOut, OutBob).

demo :- play_counting(_, _).
