%% read_along.glp - Read-along with ping-pong agents

%% === Read Word Predicate ===
%% Reads the Nth word from a list (1-indexed)

read_word(1, [Word|_], Word?).
read_word(N, [_|Rest], Word?) :- N? > 1 | N1 := N? - 1, read_word(N1?, Rest?, Word).

%% === Dream Speech Stream ===

dream_speech([i, have, a, dream, that, one, day, this, nation, will, rise, up, live,
               out, the, true, meaning, of, its, creed, we, hold, these, truths, to, be,
               self_evident, that, all, men, are, created, equal]).

%% List length
length([], 0).
length([_|Xs], N?) :- length(Xs?, N1), N := N1? + 1.

%% Identity predicate to consume values
id(_).

%% Test reading specific words from dream speech
test_word_1 :- dream_speech(Words), read_word(1, Words?, W), id(W?).
test_word_5 :- dream_speech(Words), read_word(5, Words?, W), id(W?).
test_word_10 :- dream_speech(Words), read_word(10, Words?, W), id(W?).
test_word_20 :- dream_speech(Words), read_word(20, Words?, W), id(W?).
test_word_32 :- dream_speech(Words), read_word(32, Words?, W), id(W?).

%% Demo: get dream speech length
demo_length :-
    dream_speech(Words),
    length(Words?, Len),
    id(Len?).

%% === Network switch (2-way) ===
%% Routes msg(From, To, Content) based on To field

network2((alice, ch([msg(alice, bob, X)|AliceIn], AliceOut?)),
         (bob, ch(BobIn, [msg(alice, bob, X?)|BobOut?]))) :-
    network2((alice, ch(AliceIn?, AliceOut)),
             (bob, ch(BobIn?, BobOut))).

network2((alice, ch(AliceIn, [msg(bob, alice, X?)|AliceOut?])),
         (bob, ch([msg(bob, alice, X)|BobIn], BobOut?))) :-
    network2((alice, ch(AliceIn?, AliceOut)),
             (bob, ch(BobIn?, BobOut))).

%% === Read-Along Agent ===
%% Agents take turns reading words from dream speech

%% User sends a message - forward to network
agent(Id, ch([send(To, Content)|UserIn], [sent(To?, Content?)|UserOut?]),
          ch(NetIn, [msg(Id?, To?, Content?)|NetOut?])) :-
    ground(Id?), ground(To?), ground(Content?) |
    agent(Id?, ch(UserIn?, UserOut), ch(NetIn?, NetOut)).

%% Receive read_word(I) - read word I, send read_word(I+1) if I < 33
agent(Id, ch(UserIn, [read(I?, Word?)|UserOut?]),
          ch([msg(From, To, read_word(I))|NetIn], [msg(Id?, From?, read_word(I1?))|NetOut?])) :-
    ground(Id?), ground(From?), ground(To?), ground(I?),
    Id? =?= To?, I? < 33 |
    dream_speech(DreamWords),
    read_word(I?, DreamWords?, Word),
    I1 := I? + 1,
    agent(Id?, ch(UserIn?, UserOut), ch(NetIn?, NetOut)).

%% Receive read_word(33) - read last word, done
agent(Id, ch(UserIn, [read(33, Word?)|UserOut?]),
          ch([msg(From, To, read_word(33))|NetIn], NetOut?)) :-
    ground(Id?), ground(From?), ground(To?), Id? =?= To? |
    dream_speech(DreamWords),
    read_word(33, DreamWords?, Word),
    agent(Id?, ch(UserIn?, UserOut), ch(NetIn?, NetOut)).

%% Empty inputs - close outputs
agent(_, ch([], []), ch([], [])).

%% === Actors ===

%% Alice: starts read-along by sending read_word(1)
alice_actor(_, [send(bob, read_word(1))]).

%% Bob: no user input
bob_actor(_, []).

%% === The Play ===

play_read_along :-
    %% Network switch
    network2((alice, ch(AliceNetOut?, AliceNetIn)),
             (bob, ch(BobNetOut?, BobNetIn))),

    %% Alice's agent
    agent(alice, ch(AliceUserIn?, AliceUserOut), ch(AliceNetIn?, AliceNetOut)),

    %% Bob's agent
    agent(bob, ch(BobUserIn?, BobUserOut), ch(BobNetIn?, BobNetOut)),

    %% Actors
    alice_actor(AliceUserOut?, AliceUserIn),
    bob_actor(BobUserOut?, BobUserIn).

%% === Demo ===
%% Run with :trace to see the read-along exchange

demo :- play_read_along.
