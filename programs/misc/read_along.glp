%% read_along.glp - Read-along with ping-pong agents

%% === Read Word Predicate ===
%% Reads the Nth word from a list (1-indexed)

read_word(1, [Word|_], Word?).
read_word(N, [_|Rest], Word?) :- N? > 1 | N1 := N? - 1, read_word(N1?, Rest?, Word).

%% Helper: Read word I from dream speech
%% This avoids SRSW violations by encapsulating dream_speech call
read_dream_word(I, Word) :-
    dream_speech(WordList),
    read_word(I?, WordList?, Word?).

%% === Dream Speech Stream ===

dream_speech([i, have, a, dream, that, one, day, this, nation, will, rise, up, live,
               out, the, true, meaning, of, its, creed, we, hold, these, truths, to, be,
               self_evident, that, all, men, are, created, equal]).

%% List length
length([], 0).
length([_|Xs], N?) :- length(Xs?, N1), N := N1? + 1.

%% Identity predicate to consume values
id(_).

%% === Network switch (2-way) ===
%% Routes msg(From, To, Content) based on To field

network2((alice, ch([msg(alice, bob, X)|AliceIn], AliceOut?)),
         (bob, ch(BobIn, [msg(alice, bob, X?)|BobOut?]))) :-
    network2((alice, ch(AliceIn?, AliceOut)),
             (bob, ch(BobIn?, BobOut))).

network2((alice, ch(AliceIn, [msg(bob, alice, X?)|AliceOut?])),
         (bob, ch([msg(bob, alice, X)|BobIn], BobOut?))) :-
    network2((alice, ch(AliceIn?, AliceOut)),
             (bob, ch(BobIn?, BobOut))).

%% === Read-Along Agent ===
%% Alice and Bob agents - each calls read_dream_word to get words

%% === Alice's Agent ===

alice_agent(ch([send(To, Content)|UserIn], [sent(To?, Content?)|UserOut?]),
            ch(NetIn, [msg(alice, To?, Content?)|NetOut?])) :-
    ground(To?), ground(Content?) |
    alice_agent(ch(UserIn?, UserOut), ch(NetIn?, NetOut)).

alice_agent(ch(UserIn, [read(I?, Word?)|UserOut?]),
            ch([msg(From, To, read_word(I))|NetIn], [msg(alice, From?, read_word(I1?))|NetOut?])) :-
    ground(From?), ground(To?), ground(I?), To? =?= alice, I? < 33 |
    read_dream_word(I?, Word),
    I1 := I? + 1,
    alice_agent(ch(UserIn?, UserOut), ch(NetIn?, NetOut)).

alice_agent(ch(UserIn, [read(33, Word?)|UserOut?]),
            ch([msg(From, To, read_word(33))|NetIn], NetOut?)) :-
    ground(From?), ground(To?), To? =?= alice |
    read_dream_word(33, Word),
    alice_agent(ch(UserIn?, UserOut), ch(NetIn?, NetOut)).

alice_agent(ch([], []), ch([], [])).

%% === Bob's Agent ===

bob_agent(ch([send(To, Content)|UserIn], [sent(To?, Content?)|UserOut?]),
          ch(NetIn, [msg(bob, To?, Content?)|NetOut?])) :-
    ground(To?), ground(Content?) |
    bob_agent(ch(UserIn?, UserOut), ch(NetIn?, NetOut)).

bob_agent(ch(UserIn, [read(I?, Word?)|UserOut?]),
          ch([msg(From, To, read_word(I))|NetIn], [msg(bob, From?, read_word(I1?))|NetOut?])) :-
    ground(From?), ground(To?), ground(I?), To? =?= bob, I? < 33 |
    read_dream_word(I?, Word),
    I1 := I? + 1,
    bob_agent(ch(UserIn?, UserOut), ch(NetIn?, NetOut)).

bob_agent(ch(UserIn, [read(33, Word?)|UserOut?]),
          ch([msg(From, To, read_word(33))|NetIn], NetOut?)) :-
    ground(From?), ground(To?), To? =?= bob |
    read_dream_word(33, Word),
    bob_agent(ch(UserIn?, UserOut), ch(NetIn?, NetOut)).

bob_agent(ch([], []), ch([], [])).

%% === Actors ===

%% Alice: starts read-along by sending read_word(1)
alice_actor(_, [send(bob, read_word(1))]).

%% Bob: no user input
bob_actor(_, []).

%% === The Play ===

play_read_along :-
    %% Network switch
    network2((alice, ch(AliceNetOut?, AliceNetIn)),
             (bob, ch(BobNetOut?, BobNetIn))),

    %% Alice's agent
    alice_agent(ch(AliceUserIn?, AliceUserOut), ch(AliceNetIn?, AliceNetOut)),

    %% Bob's agent
    bob_agent(ch(BobUserIn?, BobUserOut), ch(BobNetIn?, BobNetOut)),

    %% Actors
    alice_actor(AliceUserOut?, AliceUserIn),
    bob_actor(BobUserOut?, BobUserIn).

%% === Demo ===
%% Run with :trace to see the read-along exchange

demo :- play_read_along.
