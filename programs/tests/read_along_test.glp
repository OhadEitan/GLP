%% read_along.glp - Read-along with ping-pong agents
dream_speech([i, have, a, dream, that, one, day, this, nation, will, rise, up, live,
               out, the, true, meaning, of, its, creed, we, hold, these, truths, to, be,
               self_evident, that, all, men, are, created, equal]).

len([], Acc, Acc?).
len([_|T], Acc, N?) :- Acc1 := Acc? + 1, len(T?, Acc1?, N).

%% Get length of dream_speech
speech_len(N?) :- dream_speech(LA), len(LA?, 0, N).



% index(I, List, Out) - Get element at index I from List (0-based)
index(0, [H|_], H?).
index(I, [_|T], Out?) :- I? > 0 | I1 := I? - 1, index(I1?, T?, Out).

% Take element at index I from L1, append to existing Out list
index_to_list(I, L1, Out?) :-
ground(I?) | index(I?, L1?, X), Out = [X?].


% Merger: interleaves two streams
merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge([], [], []).

% Chained cooperative merge: 3 producers via 2 binary merges
chain_demo(Zs?) :-
    gen1(As),
    gen2(Bs),
    merge(As?, Bs?, Zs).


gen1(OutA?).
gen1(OutB?).



%% === Network switch (2-way) ===
network2((alice, ch([msg(alice, bob, X)|AliceIn], AliceOut?)),
         (bob, ch(BobIn, [msg(alice, bob, X?)|BobOut?]))) :-
    network2((alice, ch(AliceIn?, AliceOut)),
             (bob, ch(BobIn?, BobOut))).

network2((alice, ch(AliceIn, [msg(bob, alice, X?)|AliceOut?])),
         (bob, ch([msg(bob, alice, X)|BobIn], BobOut?))) :-
    network2((alice, ch(AliceIn?, AliceOut)),
             (bob, ch(BobIn?, BobOut))).

%% Identity predicate to consume values
id(_).


%% === Read-Along Agent ===
%% Send message from user to network
agent(Id, ch([send(To, Content)|UserIn], [sent(To?, Content?)|UserOut?]),
           ch(NetIn, [msg(Id?, To?, Content?)|NetOut?])) :-
    ground(Id?), ground(To?), ground(Content?) |
    agent(Id?, ch(UserIn?, UserOut), ch(NetIn?, NetOut)).


%% Receive read and send next if I < MaxLen
agent(Id, ch(UserIn, I?)|UserOut?]),
           ch([msg(From, To, I)|NetIn], [msg(Id?, From?, I1?)|NetOut?])) :-
    ground(Id?), ground(From?), ground(To?), ground(I?), Id? =?= To?,
    speech_len(MaxLenA), I? < MaxLenA? |
	index_to_list(I, dream_speech(LB), Out1?),
    I1 := I? + 1,
	gen1(OutA),
    agent(Id?, ch(UserIn?, UserOut), ch(NetIn?, NetOut)).

%% Receive when I = MaxLen - read last word, stop
agent(Id, ch(UserIn, I?|UserOut?]),
           ch([msg(From, To, I)|NetIn], NetOut?)) :-
    ground(Id?), ground(From?), ground(To?), ground(I?), Id? =?= To?,
    speech_len(MaxLenA), I? =:= MaxLenA? |
    index_to_list(I?, dream_speech(L), Out1),
	gen1(OutB)
    agent(Id?, ch(UserIn?, UserOut), ch(NetIn?, NetOut)).

%% Empty channels - terminate
agent(_, ch([], []), ch([], [])).

%% === Actors ===
alice_actor(_, [send(bob, 1)]).
bob_actor(_, []).


play_read_along :-
    network2((alice, ch(AliceNetOut?, AliceNetIn)),
             (bob, ch(BobNetOut?, BobNetIn))),
    agent(alice, ch(AliceUserIn?, AliceUserOut), ch(AliceNetIn?, AliceNetOut)),
    agent(bob, ch(BobUserIn?, BobUserOut), ch(BobNetIn?, BobNetOut)),
    alice_actor(AliceUserOut?, AliceUserIn),
    bob_actor(BobUserOut?, BobUserIn).

%% === Demo ===
demo :- play_read_along.
