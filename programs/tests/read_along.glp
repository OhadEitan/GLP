%% read_along.glp - Read-along with ping-pong agents
%% Bob reads odd words, Alice reads even words

dream_speech([i, have]).

%% Helper to duplicate a ground value
dup(X, Y?, Z?) :- ground(X?) | Y = X?, Z = X?.

%% Identity predicate to consume values
id(_).

%% === Ping-pong handlers ===
agent_input(_, [], []).
agent_input([I|Input], [Word|Text], Out?) :-
    I? =?= Word? |
    agent_output(Input?, Text?, Out).

agent_output(_, [], []).
agent_output(Input, [Word|Text], [Word?|Out?]) :-
    agent_input(Input?, Text?, Out).

%% === Network switch (2-way) ===
network2((alice, ch([msg(alice, bob, X)|AliceIn], AliceOut?)),
         (bob, ch(BobIn, [msg(alice, bob, X?)|BobOut?]))) :-
    network2((alice, ch(AliceIn?, AliceOut)),
             (bob, ch(BobIn?, BobOut))).

network2((alice, ch(AliceIn, [msg(bob, alice, X?)|AliceOut?])),
         (bob, ch([msg(bob, alice, X)|BobIn], BobOut?))) :-
    network2((alice, ch(AliceIn?, AliceOut)),
             (bob, ch(BobIn?, BobOut))).

%% Terminate when both done
network2((alice, ch([], [])), (bob, ch([], []))).

%% === Read-Along Agent ===

%% Send message from user to network
agent(Id, ch([send(To, Content)|UserIn], [sent(To?, Content?)|UserOut?]),
           ch(NetIn, [msg(Id?, To?, Content?)|NetOut?]), AgentBuf) :-
    ground(Id?), ground(To?), ground(Content?) |
    agent(Id?, ch(UserIn?, UserOut), ch(NetIn?, NetOut), AgentBuf?).

%% Bob receives - process and respond
agent(bob, ch(UserIn, [Content?|UserOut?]),
           ch([msg(From, bob, Content)|NetIn], [msg(bob, From?, ContentA?)|NetOut?]), AgentBuf) :-
    ground(From?), ground(Content?), ground(AgentBuf?) |
    agent_handler(bob, Content?, AgentBuf?, ContentA),
    agent(bob, ch(UserIn?, UserOut), ch(NetIn?, NetOut), AgentBuf?).

%% Alice receives - process but DON'T respond (terminates the exchange)
agent(alice, ch(UserIn, [HandlerOut?|UserOut?]),
           ch([msg(From, alice, Content)|NetIn], NetOut?), AgentBuf) :-
    ground(From?), ground(Content?), ground(AgentBuf?) |
    agent_handler(alice, Content?, AgentBuf?, HandlerOut),
    NetOut = NetIn?,
    UserOut = UserIn?.

%% Empty channels - terminate
agent(_, ch([], []), ch([], []), _).

%% Handler implementations
agent_handler(bob, In, Txt, Out?) :-
    ground(In?), ground(Txt?) |
    agent_input(In?, Txt?, Out).

agent_handler(alice, In, Txt, Out?) :-
    ground(In?), ground(Txt?) |
    agent_output(In?, Txt?, Out).

%% === Actors ===
alice_actor(_, [send(bob, [i])]).
bob_actor(_, []).

%% === The Play ===
play_read_along :-
    network2((alice, ch(AliceNetOut?, AliceNetIn)),
             (bob, ch(BobNetOut?, BobNetIn))),
    dream_speech(Txt),
    dup(Txt?, AgentBuf1, AgentBuf2),
    agent(alice, ch(AliceUserIn?, AliceUserOut), ch(AliceNetIn?, AliceNetOut), AgentBuf1?),
    agent(bob, ch(BobUserIn?, BobUserOut), ch(BobNetIn?, BobNetOut), AgentBuf2?),
    alice_actor(AliceUserOut?, AliceUserIn),
    bob_actor(BobUserOut?, BobUserIn).

demo :- play_read_along.
