%% Shared text buffer
text_buffer([1, 2, 3, 4, 5, 6, 7, 8]).

%% Helper to duplicate
dup(X, Y?, Z?) :- ground(X?) | Y = X?, Z = X?.

%% === Network switch (2-way) ===
network2((alice, ch([alice, bob, Content|AliceIn], AliceOut?)),
         (bob, ch(BobIn, [alice, bob, Content?|BobOut?]))) :-
    network2((alice, ch(AliceIn?, AliceOut)),
             (bob, ch(BobIn?, BobOut))).

network2((alice, ch(AliceIn, [bob, alice, Content?|AliceOut?])),
         (bob, ch([bob, alice, Content|BobIn], BobOut?))) :-
    network2((alice, ch(AliceIn?, AliceOut)),
             (bob, ch(BobIn?, BobOut))).

network2((alice, ch([], [])), (bob, ch([], []))).

%% === Alice (2 predicates) ===
%% alice_handler: Send first word, then continue
%% alice_continue: Wait for Bob's reply, send next word, loop

alice_handler([Word, _ | Text], NetIn, [alice, bob, Word?|NetOut?], [Word?|Log?]) :-
    ground(Word?) |
    alice_continue(Text?, NetIn?, NetOut, Log).

alice_handler([Word], NetIn, [alice, bob, Word?|NetOut?], [Word?|Log?]) :-
    ground(Word?) |
    alice_continue([], NetIn?, NetOut, Log).

alice_handler([], _, [], []).

%% Wait for Bob's reply (guard suspends until NetIn is bound), send next, loop
alice_continue([Word, _ | Text], NetIn, [alice, bob, Word?|NetOut?], [Word?|Log?]) :-
    NetIn? = [bob, alice, _|NetInRest], ground(Word?) |
    alice_continue(Text?, NetInRest?, NetOut, Log).

alice_continue([Word], NetIn, [alice, bob, Word?|NetOut?], [Word?|Log?]) :-
    NetIn? = [bob, alice, _|NetInRest], ground(Word?) |
    alice_continue([], NetInRest?, NetOut, Log).

alice_continue([], _, [], []).

%% === Bob handler ===
%% Bob waits for message, then takes 2nd element (skips 1st), continues
bob_handler(Text, NetIn, NetOut?, Log?) :-
    list(NetIn?), list(Text?) |
    bob_match(Text?, NetIn?, NetOut, Log).

bob_handler([], _, [], []).

%% Bob skips 1st, takes 2nd
bob_match([_, Word | Text], [alice, bob, _|NetIn], [bob, alice, Word?|NetOut?], [Word?|Log?]) :-
    ground(Word?) |
    bob_handler(Text?, NetIn?, NetOut, Log).

%% Bob has only 1 element left - skip it (nothing to take)
bob_match([_], [alice, bob, _|_], NetOut?, Log?) :-
    NetOut = [], Log = [].

bob_match([], _, [], []).

%% === Play ===
play_counting(OutAlice?, OutBob?) :-
    text_buffer(Txt),
    dup(Txt?, AliceText, BobText),

    network2((alice, ch(AliceNetOut?, AliceNetIn)),
             (bob, ch(BobNetOut?, BobNetIn))),

    alice_handler(AliceText?, AliceNetIn?, AliceNetOut, OutAlice),
    bob_handler(BobText?, BobNetIn?, BobNetOut, OutBob).

demo :- play_counting(_, _).
